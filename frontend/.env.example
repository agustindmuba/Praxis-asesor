# Variables de entorno del frontend de Praxis Asesor.
#
# Copiar a `.env.local` (gitignored). Las variables NEXT_PUBLIC_* se exponen
# al cliente; las que NO tienen ese prefijo solo están disponibles en server.

# --- Backend ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Clerk ---
# Obtener del dashboard de Clerk (https://dashboard.clerk.com).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# URLs de Clerk (defaults razonables; ajustar si cambia el routing).
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
