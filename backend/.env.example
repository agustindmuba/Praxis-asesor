# Variables de entorno del backend de Praxis Asesor.
#
# Copiar este archivo a `backend/.env` (gitignored) y completar valores reales.
# El archivo `.env` NUNCA se commitea.

# Entorno de ejecución: dev | staging | prod.
ENV=dev

# Conexión a Postgres (debe coincidir con docker-compose.yml).
# Nota: usar el driver `asyncpg` (no `psycopg2`).
DATABASE_URL=postgresql+asyncpg://praxis:praxis@localhost:5432/praxis

# Conexión a Redis (debe coincidir con docker-compose.yml).
REDIS_URL=redis://localhost:6379/0

# API key de Anthropic. Opcional hasta que se usen features de IA (roadmap v3+).
# ANTHROPIC_API_KEY=sk-ant-...

# Nivel de logging: DEBUG | INFO | WARNING | ERROR | CRITICAL.
LOG_LEVEL=INFO
