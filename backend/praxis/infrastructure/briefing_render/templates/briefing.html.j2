<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<title>Briefing pre-sesión</title>
<style>
  /* Paleta Praxis Consulting (manual de marca). */
  :root {
    --azul: #2A3D75;
    --azul-dark: #1F2E58;
    --salmon: #D48D7C;
    --crema: #F4F0EF;
    --crema-dark: #E6E0DE;
    --verde: #3B6652;
    --lavanda: #8097D0;
    --tinta: #1A1D2E;
    --tinta-muted: #5A5D6E;
    --hairline: #D9D3D1;
  }

  /* Importamos las fuentes web. weasyprint las descarga al renderizar. */
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap');

  @page { size: A4; margin: 18mm 16mm; }

  body {
    font-family: "Inter", "Helvetica Neue", Helvetica, Arial, sans-serif;
    color: var(--tinta);
    background: white;
    font-size: 10.5pt;
    line-height: 1.5;
    margin: 0;
  }

  /* Tipografía display para titulares. */
  h1, h2, h3 {
    font-family: "Space Grotesk", "Inter", sans-serif;
    letter-spacing: -0.015em;
    color: var(--azul);
  }
  h1 { font-size: 19pt; font-weight: 700; margin: 0 0 4pt; }
  h2 {
    font-size: 13pt;
    font-weight: 600;
    margin: 16pt 0 8pt;
    padding-bottom: 4pt;
    border-bottom: 2px solid var(--azul);
    letter-spacing: -0.01em;
  }
  h3 {
    font-size: 11pt;
    font-weight: 600;
    margin: 12pt 0 6pt;
    color: var(--azul);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  h4 {
    font-size: 8.5pt;
    margin: 0 0 2pt;
    text-transform: uppercase;
    color: var(--tinta-muted);
    letter-spacing: 0.06em;
    font-weight: 600;
  }

  /* Encabezado de portada con brand line. */
  .brand-strip {
    display: flex;
    align-items: baseline;
    gap: 8pt;
    margin-bottom: 4pt;
  }
  .brand-strip .mark {
    font-family: "Space Grotesk", sans-serif;
    font-size: 13pt;
    font-weight: 700;
    color: var(--azul);
    letter-spacing: -0.02em;
  }
  .brand-strip .mark .dot { color: var(--salmon); }
  .brand-strip .tagline {
    font-size: 8.5pt;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--tinta-muted);
  }

  .meta-row {
    color: var(--tinta-muted);
    font-size: 9.5pt;
    margin-bottom: 12pt;
  }
  .meta-row span { margin-right: 10pt; }

  /* Counters de portada — placas limpias sobre crema. */
  .counter-grid {
    display: flex;
    gap: 10pt;
    margin: 8pt 0 16pt;
  }
  .counter {
    flex: 1;
    background: var(--crema);
    border-left: 3px solid var(--azul);
    padding: 9pt 11pt;
    border-radius: 0 4pt 4pt 0;
  }
  .counter:nth-child(2) { border-left-color: var(--salmon); }
  .counter:nth-child(3) { border-left-color: var(--verde); }
  .counter .num {
    font-family: "Space Grotesk", sans-serif;
    font-size: 20pt;
    font-weight: 700;
    color: var(--azul);
    line-height: 1;
  }
  .counter .label {
    font-size: 8.5pt;
    color: var(--tinta-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-top: 4pt;
  }

  /* Alertas: borde lateral del color de la prioridad. */
  .alerta {
    display: flex;
    gap: 9pt;
    align-items: flex-start;
    padding: 9pt 11pt;
    margin-bottom: 7pt;
    border-left: 3px solid var(--hairline);
    background: var(--crema);
    border-radius: 0 4pt 4pt 0;
  }
  .alerta .badge {
    color: white;
    font-size: 7.5pt;
    font-weight: 700;
    padding: 2pt 7pt;
    border-radius: 3pt;
    letter-spacing: 0.07em;
    flex-shrink: 0;
    line-height: 1.3;
    font-family: "Space Grotesk", sans-serif;
  }
  .alerta .titulo { font-weight: 600; margin-bottom: 2pt; color: var(--tinta); }
  .alerta .detalle { color: var(--tinta-muted); font-size: 9.5pt; }

  /* Card de proyecto del despacho. */
  .proyecto {
    page-break-inside: avoid;
    margin-bottom: 14pt;
    padding: 12pt 14pt;
    border: 1px solid var(--hairline);
    border-radius: 6pt;
    background: white;
  }
  .proyecto .head {
    display: flex;
    justify-content: space-between;
    gap: 8pt;
    margin-bottom: 4pt;
    align-items: baseline;
  }
  .proyecto .titulo {
    font-family: "Space Grotesk", sans-serif;
    font-weight: 600;
    font-size: 11.5pt;
    flex: 1;
    color: var(--azul);
    letter-spacing: -0.01em;
  }
  .proyecto .meta {
    font-size: 9pt;
    color: var(--tinta-muted);
    margin-bottom: 10pt;
    padding-bottom: 8pt;
    border-bottom: 1px solid var(--hairline);
  }
  .proyecto .meta span { margin-right: 12pt; }
  .proyecto .meta strong { color: var(--azul); font-weight: 600; }
  .proyecto h4 { margin-top: 10pt; color: var(--azul); }
  .proyecto ul, .proyecto ol { margin: 4pt 0 6pt 18pt; padding: 0; }
  .proyecto li { margin-bottom: 3pt; line-height: 1.45; }

  .cofirmante {
    display: flex;
    justify-content: space-between;
    gap: 12pt;
    align-items: center;
    padding: 6pt 0;
    border-bottom: 1px solid var(--crema-dark);
    font-size: 9.5pt;
  }
  .cofirmante:last-child { border-bottom: none; }
  .cofirmante .cofirmante-info { flex: 1; }
  .cofirmante .nombre { font-weight: 600; color: var(--tinta); }
  .cofirmante .bloque { color: var(--tinta-muted); font-size: 8.5pt; margin-top: 1pt; }
  .cofirmante .razon {
    color: var(--tinta-muted);
    font-size: 8.5pt;
    font-style: italic;
    margin-top: 3pt;
    line-height: 1.4;
  }
  .cofirmante .count {
    font-family: "Space Grotesk", sans-serif;
    font-weight: 700;
    color: var(--salmon);
    font-size: 16pt;
    line-height: 1;
    white-space: nowrap;
    text-align: center;
    align-self: center;
  }
  .cofirmante .count .count-label {
    display: block;
    font-family: "Inter", sans-serif;
    font-size: 7pt;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--tinta-muted);
    margin-top: 2pt;
  }

  .antecedente {
    background: var(--crema);
    padding: 7pt 10pt;
    border-radius: 4pt;
    font-size: 9.5pt;
    margin-top: 6pt;
    border-left: 3px solid var(--lavanda);
  }
  .antecedente strong { color: var(--azul); }

  /* Página 3: secciones por área. */
  .area-section { page-break-inside: avoid; margin-bottom: 14pt; }
  .area-row {
    display: flex;
    gap: 9pt;
    padding: 6pt 8pt;
    border-bottom: 1px solid var(--crema-dark);
    align-items: flex-start;
  }
  .area-row:last-child { border-bottom: none; }
  .area-row .info { flex: 1; font-size: 9.5pt; }
  .area-row .info .titulo { font-weight: 600; color: var(--tinta); }
  .area-row .info .autor { color: var(--tinta-muted); font-size: 8.5pt; margin-top: 2pt; }
  .area-row .info .razon { color: var(--tinta-muted); font-size: 9pt; margin-top: 3pt; }
  .area-row .rec {
    color: white;
    font-size: 7.5pt;
    font-weight: 700;
    padding: 3pt 7pt;
    border-radius: 3pt;
    letter-spacing: 0.06em;
    line-height: 1.3;
    align-self: flex-start;
    white-space: nowrap;
    font-family: "Space Grotesk", sans-serif;
  }

  .page-break { page-break-after: always; }
  .footer {
    margin-top: 24pt;
    padding-top: 8pt;
    border-top: 1px solid var(--hairline);
    font-size: 8pt;
    color: var(--tinta-muted);
    text-align: center;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
</style>
</head>
<body>

{# ============== PÁGINA 1 — Resumen ejecutivo ============== #}
<div class="brand-strip">
  <span class="mark">Praxis<span class="dot">.</span></span>
  <span class="tagline">Decisiones estratégicas basadas en datos</span>
</div>
<h1>Briefing pre-sesión</h1>
<div class="meta-row">
  <span>Generado: {{ briefing.generado_en.strftime("%d/%m/%Y %H:%M") if briefing.generado_en else "—" }}</span>
  <span>Modelo: {{ briefing.modelo_llm }}</span>
  <span>Versión: {{ briefing.prompt_version }}</span>
</div>

<div class="counter-grid">
  <div class="counter">
    <div class="num">{{ briefing.proyectos_del_despacho_total }}</div>
    <div class="label">Proyectos del despacho en el OD</div>
  </div>
  <div class="counter">
    <div class="num">{{ briefing.proyectos_como_autor }}</div>
    <div class="label">Como autor</div>
  </div>
  <div class="counter">
    <div class="num">{{ briefing.proyectos_como_cofirmante }}</div>
    <div class="label">Como cofirmante</div>
  </div>
</div>

<h2>Alertas priorizadas</h2>
{% if briefing.alertas %}
  {% for alerta in briefing.alertas %}
    {% set bg, label = prioridad_badge[alerta.prioridad] %}
    <div class="alerta" style="border-left-color: {{ bg }};">
      <span class="badge" style="background: {{ bg }};">{{ label }}</span>
      <div>
        <div class="titulo">{{ alerta.titulo }}</div>
        <div class="detalle">{{ alerta.detalle }}</div>
      </div>
    </div>
  {% endfor %}
{% else %}
  <p style="color: #6b7280;">Sin alertas para esta sesión.</p>
{% endif %}

<div class="page-break"></div>

{# ============== PÁGINA 2 — Proyectos del despacho ============== #}
<h1>Proyectos del despacho en el OD</h1>

{% if briefing.secciones_proyectos %}
  {% for sec in briefing.secciones_proyectos %}
    <div class="proyecto">
      <div class="head">
        <div class="titulo">
          {{ "%04d-%s-%d" | format(sec.numero.numero, sec.numero.origen.value, sec.numero.anio) }}
          — {{ sec.titulo }}
        </div>
      </div>
      <div class="meta">
        <span><strong>{{ rol_label[sec.rol_despacho] }}</strong></span>
        <span>{{ estado_label.get(sec.estado.value, sec.estado.value) }}</span>
        <span>Área: {{ area_label[sec.area] }}</span>
        {% if sec.dias_en_etapa is not none %}
          <span>{{ sec.dias_en_etapa }} días en etapa</span>
        {% endif %}
      </div>

      <h4>Argumentos a favor</h4>
      <ul>
        {% for arg in sec.argumentos %}<li>{{ arg }}</li>{% endfor %}
      </ul>

      <h4>Contraargumentos esperables</h4>
      <ul>
        {% for arg in sec.contraargumentos %}<li>{{ arg }}</li>{% endfor %}
      </ul>

      <h4>Cofirmantes naturales</h4>
      {% if sec.cofirmantes_naturales %}
        {% for c in sec.cofirmantes_naturales %}
          <div class="cofirmante">
            <div class="cofirmante-info">
              <div class="nombre">{{ c.nombre }}</div>
              <div class="bloque">{{ c.bloque or "—" }}{% if c.distrito %} · {{ c.distrito }}{% endif %}</div>
              <div class="razon">{{ c.razon }}</div>
            </div>
            <div class="count">
              {{ c.proyectos_similares_firmados }}
              <span class="count-label">parecidos</span>
            </div>
          </div>
        {% endfor %}
      {% else %}
        <p style="color: var(--tinta-muted); font-size: 10pt;">Sin sugerencias disponibles.</p>
      {% endif %}

      <h4>Antecedente más parecido</h4>
      {% if sec.antecedente %}
        <div class="antecedente">
          <strong>{{ "%04d-%s-%d" | format(
            sec.antecedente.numero.numero,
            sec.antecedente.numero.origen.value,
            sec.antecedente.numero.anio
          ) }}</strong>
          — {{ sec.antecedente.titulo }}
          <br>
          Resultado: <strong>{{ estado_label.get(sec.antecedente.estado_terminal.value, sec.antecedente.estado_terminal.value) }}</strong>
          · Similitud: {{ "%.2f"|format(sec.antecedente.similitud) }}
        </div>
      {% else %}
        <p style="color: #6b7280; font-size: 10pt;">Sin antecedente histórico claro.</p>
      {% endif %}
    </div>
  {% endfor %}
{% else %}
  <p style="color: #6b7280;">Ninguno de los proyectos del despacho está en este orden del día.</p>
{% endif %}

<div class="page-break"></div>

{# ============== PÁGINA 3 — Resto del OD por área ============== #}
<h1>Resto del OD por área temática</h1>

{% if briefing.secciones_areas %}
  {% for sa in briefing.secciones_areas %}
    <div class="area-section">
      <h3>{{ area_label[sa.area] }} ({{ sa.proyectos|length }})</h3>
      {% for p in sa.proyectos %}
        {% set rec_bg, rec_label = recomendacion_label[p.recomendacion] %}
        <div class="area-row">
          <div class="info">
            <span class="titulo">
              {{ "%04d-%s-%d" | format(p.numero.numero, p.numero.origen.value, p.numero.anio) }}
            </span>
            — {{ p.titulo }}
            {% if p.autor_principal %}
              <div class="autor">{{ p.autor_principal }}{% if p.bloque_autor %} ({{ p.bloque_autor }}){% endif %}</div>
            {% endif %}
            <div class="razon">{{ p.razon }}</div>
          </div>
          <span class="rec" style="background: {{ rec_bg }};">{{ rec_label }}</span>
        </div>
      {% endfor %}
    </div>
  {% endfor %}
{% else %}
  <p style="color: #6b7280;">Sin proyectos en el resto del OD.</p>
{% endif %}

<div class="footer">
  Praxis Consulting · Briefing pre-sesión {{ briefing.prompt_version }}
</div>

</body>
</html>
