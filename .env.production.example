# --------------------------------------------------------------------
# Praxis Asesor — variables de entorno de producción.
#
# Copiar como `.env` en la raíz del proyecto en el VPS y setear
# valores reales. NO commitear este archivo con valores reales al repo.
#
# Todos estos vars son leídos por `docker-compose.prod.yml` via `${VAR}`.
# --------------------------------------------------------------------

# ---- Dominio público ----
# Sin http://, sin path. Solo el hostname.
PUBLIC_HOST=praxisconsultora.com

# ---- Postgres ----
# Password fuerte, distinto al de dev.
# Generá uno con: openssl rand -base64 32
POSTGRES_PASSWORD=CAMBIAME_generar_con_openssl

# ---- Anthropic ----
ANTHROPIC_API_KEY=sk-ant-api03-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---- Meta WhatsApp Cloud API ----
# System User token permanente (NO el temporal de 24h).
META_WHATSAPP_TOKEN=EAA...
META_WHATSAPP_PHONE_NUMBER_ID=1192656733921760
# Token que declaraste en el panel de Meta al configurar el webhook.
META_WHATSAPP_VERIFY_TOKEN=CAMBIAME_string_random

# ---- Clerk (auth) ----
# En prod se necesitan las keys de una app Clerk configurada con el
# dominio real, no la key dev.
CLERK_SECRET_KEY=sk_live_...
CLERK_JWT_ISSUER=https://clerk.praxisconsultora.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...

# ---- Logging ----
LOG_LEVEL=INFO
